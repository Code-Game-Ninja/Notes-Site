rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Notes collection - main functionality
    match /notes/{noteId} {
      // Anyone can read approved notes, admins can read all
      allow read: if resource.data.status == 'approved' || isAdmin();
      
      // Only authenticated users can create notes
      // Must include required fields and correct user ID
      allow create: if request.auth != null 
                    && request.resource.data.keys().hasAll([
                      'title', 'subject', 'fileName', 'fileSize', 
                      'fileType', 'downloadURL', 'uploadedBy', 
                      'uploaderName', 'uploaderEmail', 'timestamp', 'status'
                    ])
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.uploaderEmail == request.auth.token.email
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.subject in [
                      'computer-networks', 'software-engineering', 
                      'toc', 'computer-graphics', 'pyq-papers'
                    ];
      
      // Only admins can update notes (for approval/rejection)
      // Or uploaders can update their own pending notes
      allow update: if isAdmin() || 
                    (request.auth != null 
                     && resource.data.uploadedBy == request.auth.uid
                     && resource.data.status == 'pending'
                     && request.resource.data.uploadedBy == request.auth.uid);
      
      // Only admins can delete notes, or uploaders can delete their own pending notes
      allow delete: if isAdmin() ||
                    (request.auth != null 
                     && resource.data.uploadedBy == request.auth.uid
                     && resource.data.status == 'pending');
    }
    
    // Users collection - for role-based access control
    match /users/{userId} {
      // Users can read their own profile, admins can read all profiles
      allow read: if request.auth != null && 
                  (request.auth.uid == userId || isAdmin());
      
      // Users can create/update their own profile
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.email == request.auth.token.email;
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
    
    // Analytics collection (optional - for download counts, etc.)
    match /analytics/{docId} {
      // Only authenticated users can read analytics
      allow read: if request.auth != null;
      
      // System can write analytics (via Cloud Functions)
      allow write: if false; // Disabled for now
    }
  }
}